# Version control
.git
.gitignore

# Node dependencies and build caches
**/node_modules
**/.next
**/dist
**/.turbo
**/.cache
**/coverage

# Test artifacts
**/*.test.ts
**/*.spec.ts
**/__tests__
**/jest.config.js
**/jest.setup.js

# Local environment & IDE files
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.vscode
**/.idea
**/.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Terraform temporary workspaces
**/terraform_workspaces/*
!**/terraform_workspaces/.gitkeep

# Local infrastructure artifacts
.local-infra/pgdata
.local-infra/pdfs
.local-infra/*.png
.local-infra/*.tmp.js
.local-infra/fresh-token.txt
