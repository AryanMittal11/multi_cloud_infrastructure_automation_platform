# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multicloud_db?schema=public"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="1d"

# AES-256 Encryption for Stored Cloud Credentials (32-byte hex string)
CREDENTIAL_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# RabbitMQ Broker URL
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Worker Settings
TERRAFORM_WORKSPACE_DIR="./terraform_workspaces"

# CORS Origin
CORS_ORIGIN="http://localhost:3000"
