# ==============================================================================
# Docker Compose Environment Variables Configuration
# Copy this file to .env before running `docker compose up`
# ==============================================================================

# Database Settings
# (Optional) If you have a direct hosted PostgreSQL connection string (Supabase/Neon/RDS/Prisma Accelerate):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multicloud_db?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=multicloud_db
POSTGRES_PORT=5432

# Message Broker Settings
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Control Plane API Settings
BACKEND_PORT=4000
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
RUN_SEED=true

# Frontend Dashboard Settings
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=/api

# Gateway NGINX Ingress Port
GATEWAY_PORT=80

# CORS Whitelist (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost,http://localhost:80

# Optional AI Assistant API Key
GEMINI_API_KEY=
